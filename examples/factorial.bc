# factorial with a constant-foldable prefix, dead code and jump chains
func fact(n)
  load n
  push 1
  gt
  jz base
  load n
  load n
  push 1
  sub
  call fact 1
  mul
  ret
base:
  push 1
  ret
end

func main
  push 2
  push 3
  add
  call fact 1
  print
  jmp middle
  push 111
  print
middle:
  jmp endlab
  push 222
  print
endlab:
  push 0
  ret
end
